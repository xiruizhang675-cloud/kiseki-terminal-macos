# ============================================================
# ★ Kiseki Terminal (macOS) — Zsh + Ghostty Live Theme Engine
# ============================================================

export KISEKI_ROOT="${KISEKI_ROOT:-$HOME/.config/kiseki-terminal}"
typeset -g _KISEKI_CURRENT_FILE="$KISEKI_ROOT/current-theme.txt"
typeset -g _KISEKI_CRT_FILE="$KISEKI_ROOT/crt-mode.txt"
typeset -g _KISEKI_BG_FILE="$KISEKI_ROOT/bg-opacity.txt"
typeset -g _KISEKI_FONT_FILE="$KISEKI_ROOT/font-override.txt"
typeset -g _KISEKI_GHOSTTY_ACTIVE="$KISEKI_ROOT/ghostty-active.conf"
typeset -g _KISEKI_CRT_SHADER="$KISEKI_ROOT/shaders/retro-crt-subtle.glsl"

typeset -ga _KISEKI_THEME_IDS=(starlight-8bit nerv-eva shinkai-rain kyoto-sakura)

_kiseki_active_theme() {
  if [[ -f "$_KISEKI_CURRENT_FILE" ]]; then
    local id
    id="$(tr -d '[:space:]' < "$_KISEKI_CURRENT_FILE")"
    if [[ -n "$id" && -f "$KISEKI_ROOT/themes/$id/theme.json" ]]; then
      print -r -- "$id"
      return 0
    fi
  fi
  print -r -- "starlight-8bit"
}

_kiseki_crt_enabled() {
  [[ -f "$_KISEKI_CRT_FILE" && "$(tr -d '[:space:]' < "$_KISEKI_CRT_FILE")" == "on" ]]
}

_kiseki_reload_ghostty() {
  # Ghostty reloads its config on SIGUSR2; users can also press Cmd+Shift+,
  if pgrep -x ghostty >/dev/null 2>&1; then
    pkill -USR2 -x ghostty 2>/dev/null || true
  fi
}

_kiseki_sync_ghostty() {
  local id="${1:-$(_kiseki_active_theme)}"
  local base_conf="$KISEKI_ROOT/ghostty-themes/$id.conf"
  [[ -f "$base_conf" ]] || return 1

  {
    print -r -- "# Auto-generated by Kiseki Terminal (theme: $id)"
    sed "s|__KISEKI_ROOT__|$KISEKI_ROOT|g" "$base_conf"

    # Optional wallpaper override (opacity or off)
    if [[ -f "$_KISEKI_BG_FILE" ]]; then
      local bg_val
      bg_val="$(tr -d '[:space:]' < "$_KISEKI_BG_FILE")"
      if [[ "$bg_val" == "off" ]]; then
        print -r -- ""
        print -r -- "# Wallpaper disabled by termbg"
        print -r -- "background-image ="
      elif [[ -n "$bg_val" ]]; then
        print -r -- ""
        print -r -- "# Wallpaper opacity override by termbg"
        print -r -- "background-image-opacity = $bg_val"
      fi
    fi

    # Optional font override
    if [[ -f "$_KISEKI_FONT_FILE" ]]; then
      local fstyle
      fstyle="$(tr -d '[:space:]' < "$_KISEKI_FONT_FILE")"
      case "$fstyle" in
        maple)
          print -r -- ""
          print -r -- "font-family = \"\""
          print -r -- "font-family = \"Maple Mono NF CN\""
          print -r -- "font-family = \"JetBrainsMono Nerd Font\""
          print -r -- "font-family = \"JetBrains Mono\""
          ;;
        modern)
          print -r -- ""
          print -r -- "font-family = \"\""
          print -r -- "font-family = \"JetBrainsMono Nerd Font\""
          print -r -- "font-family = \"JetBrains Mono\""
          print -r -- "font-family = \"Maple Mono NF CN\""
          ;;
        8bit)
          print -r -- ""
          print -r -- "font-family = \"\""
          print -r -- "font-family = \"DepartureMono Nerd Font\""
          print -r -- "font-family = \"Fusion Pixel 12px Monospaced zh_hans\""
          print -r -- "font-family = \"Maple Mono NF CN\""
          ;;
      esac
    fi

    # Optional CRT GLSL shader
    print -r -- ""
    if _kiseki_crt_enabled && [[ -f "$_KISEKI_CRT_SHADER" ]]; then
      print -r -- "# Retro CRT Shader: ON"
      print -r -- "custom-shader = $_KISEKI_CRT_SHADER"
      print -r -- "custom-shader-animation = false"
    else
      print -r -- "# Retro CRT Shader: OFF"
      print -r -- "custom-shader ="
    fi
  } > "$_KISEKI_GHOSTTY_ACTIVE"

  _kiseki_reload_ghostty
}

_kiseki_apply_shell_theme() {
  local id="${1:-$(_kiseki_active_theme)}"
  local theme_dir="$KISEKI_ROOT/themes/$id"
  export KISEKI_ACTIVE_THEME="$id"
  export KISEKI_FASTFETCH_CONFIG="$theme_dir/fastfetch.jsonc"

  # 1. Oh My Posh prompt
  if (( $+commands[oh-my-posh] )) && [[ -f "$theme_dir/prompt.omp.json" ]]; then
    export POSH_SESSION_ID="$(uuidgen 2>/dev/null || print -r -- "$$-$RANDOM")"
    eval "$(oh-my-posh init zsh --config "$theme_dir/prompt.omp.json")"
  fi

  # 2. Per-theme EZA_COLORS, BAT_THEME, and FZF_DEFAULT_OPTS
  case "$id" in
    starlight-8bit)
      export EZA_COLORS="di=38;2;102;240;255:ex=38;2;114;241;184:ln=38;2;255;130;184:da=38;2;143;152;201:sn=38;2;255;213;128:sb=38;2;180;142;254:uu=38;2;180;142;254:ga=38;2;114;241;184:gm=38;2;255;213;128:gd=38;2;255;107;139:gv=38;2;102;240;255"
      export BAT_THEME="Catppuccin Mocha"
      export FZF_DEFAULT_OPTS='--height=45% --layout=reverse --border=sharp --prompt="▶ " --pointer="♥" --marker="★" --color=bg+:#1A2146,bg:#0A0F25,spinner:#66F0FF,hl:#FF82B8,fg:#D6DCFA,header:#B48EFE,info:#FFD580,pointer:#FF82B8,marker:#72F1B8,fg+:#F8FAFF,prompt:#66F0FF,hl+:#FF8FAD,border:#4E568A,label:#66F0FF,query:#E8ECFF'
      ;;
    nerv-eva)
      export EZA_COLORS="di=38;2;240;106;34:ex=38;2;63;224;138:ln=38;2;98;198;242:da=38;2;125;112;107:sn=38;2;245;201;106:sb=38;2;240;106;34:uu=38;2;255;192;143:ga=38;2;63;224;138:gm=38;2;240;106;34:gd=38;2;216;38;46:gv=38;2;98;198;242"
      export BAT_THEME="TwoDark"
      export FZF_DEFAULT_OPTS='--height=45% --layout=reverse --border=sharp --prompt="02▸ " --pointer="▸" --marker="■" --color=bg+:#241418,bg:#0B090A,spinner:#F06A22,hl:#F0413C,fg:#DDD3C9,header:#F06A22,info:#3FE08A,pointer:#D8262E,marker:#3FE08A,fg+:#FFF7F2,prompt:#F06A22,hl+:#FF8A3D,border:#55383B,label:#F06A22,query:#ECE4DA'
      ;;
    shinkai-rain)
      export EZA_COLORS="di=38;2;92;230;208:ex=38;2;154;230;160:ln=38;2;127;184;255:da=38;2;127;160;178:sn=38;2;255;203;119:sb=38;2;186;156;255:uu=38;2;127;184;255:ga=38;2;154;230;160:gm=38;2;255;203;119:gd=38;2;255;122;153:gv=38;2;92;230;208"
      export BAT_THEME="Nord"
      export FZF_DEFAULT_OPTS='--height=45% --layout=reverse --border=rounded --prompt="❯ " --pointer="●" --marker="◆" --color=bg+:#152C3B,bg:#0C1823,spinner:#5CE6D0,hl:#FFCB77,fg:#CFE3EC,header:#7FB8FF,info:#FFCB77,pointer:#5CE6D0,marker:#9AE6A0,fg+:#F4FBFF,prompt:#5CE6D0,hl+:#FFE0A3,border:#3C5A6A,label:#5CE6D0,query:#E2F2F8'
      ;;
    kyoto-sakura)
      export EZA_COLORS="di=38;2;255;158;199:ex=38;2;134;227;206:ln=38;2;196;167;255:da=38;2;158;134;173:sn=38;2;255;201;113:sb=38;2;196;167;255:uu=38;2;255;158;199:ga=38;2;134;227;206:gm=38;2;255;201;113:gd=38;2;255;107;123:gv=38;2;196;167;255"
      export BAT_THEME="Catppuccin Mocha"
      export FZF_DEFAULT_OPTS='--height=45% --layout=reverse --border=rounded --prompt="❀ " --pointer="✿" --marker="★" --color=bg+:#281938,bg:#0F0B19,spinner:#FF9EC7,hl:#FFC971,fg:#EADAE6,header:#FF9EC7,info:#FFC971,pointer:#FF9EC7,marker:#86E3CE,fg+:#FFF7FC,prompt:#FFC971,hl+:#FFE0A3,border:#634873,label:#FF9EC7,query:#F7EBF4'
      ;;
  esac
}

themes() {
  local active crt_tag
  active="$(_kiseki_active_theme)"
  crt_tag="CRT:OFF"
  _kiseki_crt_enabled && crt_tag="CRT:ON"

  print -P "\n%F{cyan}★ Kiseki Anime Terminal Themes [macOS · Ghostty · $crt_tag]%f  (switch: theme <id> | shader: crt)"
  print ""
  local -A labels=(
    starlight-8bit "[8-bit Pixel Art]        星屑 8-Bit · 复古二次元像素夜空"
    nerv-eva       "[NERV-BASE Unit-02]      特務機関 NERV 弐号機 · 战术蓝图暗红橙"
    shinkai-rain   "[Cinematic Painterly]    言叶之雨 · 新海诚东京雨夜电影感"
    kyoto-sakura   "[Japanese Fantasy]       夜樱绘卷 · 和风月夜神社与垂枝樱"
  )
  local id mark color
  for id in "${_KISEKI_THEME_IDS[@]}"; do
    if [[ "$id" == "$active" ]]; then
      mark="▶"
      color="35"
    else
      mark=" "
      color="37"
    fi
    printf "  \033[1;%sm%s %-16s %s\033[0m\n" "$color" "$mark" "$id" "${labels[$id]}"
  done
  print ""
}

theme() {
  local name="$1"
  if [[ -z "$name" ]]; then
    themes
    return 0
  fi

  if [[ ! -f "$KISEKI_ROOT/themes/$name/theme.json" ]]; then
    print -P "%F{red}✖ Unknown theme '$name'%f"
    themes
    return 1
  fi

  print -rn -- "$name" > "$_KISEKI_CURRENT_FILE"
  _kiseki_sync_ghostty "$name"
  _kiseki_apply_shell_theme "$name"
  print -P "%F{cyan}✦ Switched to [$name]%f (press Cmd+Shift+, if Ghostty did not auto-reload)"
  fetch
}

crt() {
  local mode="${1:-toggle}"
  local next="off"
  case "$mode" in
    on)  next="on" ;;
    off) next="off" ;;
    toggle|"")
      if _kiseki_crt_enabled; then next="off"; else next="on"; fi
      ;;
    *)
      print -P "%F{red}Usage: crt [on|off|toggle]%f"
      return 1
      ;;
  esac

  print -rn -- "$next" > "$_KISEKI_CRT_FILE"
  _kiseki_sync_ghostty
  if [[ "$next" == "on" ]]; then
    print -P "%F{magenta}✦ Retro CRT Shader: ON%f (subtle phosphor bloom + 2px scanlines)"
  else
    print -P "%F{cyan}✦ Retro CRT Shader: OFF%f"
  fi
}

termbg() {
  local val="$1"
  if [[ -z "$val" || "$val" == "reset" ]]; then
    rm -f "$_KISEKI_BG_FILE"
    _kiseki_sync_ghostty
    print -P "%F{cyan}✦ Wallpaper restored to theme default opacity%f"
  elif [[ "$val" == "off" || "$val" == "-off" ]]; then
    print -rn -- "off" > "$_KISEKI_BG_FILE"
    _kiseki_sync_ghostty
    print -P "%F{magenta}✦ Wallpaper: OFF%f"
  else
    print -rn -- "$val" > "$_KISEKI_BG_FILE"
    _kiseki_sync_ghostty
    print -P "%F{magenta}✦ Wallpaper opacity -> $val%f"
  fi
}

termfont() {
  local style="$1"
  case "$style" in
    maple|modern|8bit)
      print -rn -- "$style" > "$_KISEKI_FONT_FILE"
      _kiseki_sync_ghostty
      print -P "%F{cyan}✦ Font stack -> $style%f"
      ;;
    reset|"")
      rm -f "$_KISEKI_FONT_FILE"
      _kiseki_sync_ghostty
      print -P "%F{cyan}✦ Font stack restored to theme default%f"
      ;;
    *)
      print -P "%F{red}Usage: termfont <maple|modern|8bit|reset>%f"
      return 1
      ;;
  esac
}

fetch() {
  if (( $+commands[fastfetch] )); then
    local cfg="${KISEKI_FASTFETCH_CONFIG:-$KISEKI_ROOT/themes/$(_kiseki_active_theme)/fastfetch.jsonc}"
    [[ -f "$cfg" ]] && fastfetch --config "$cfg" "$@"
  fi
}
alias neofetch='fetch'

# --- Modern CLI aliases (loaded after Oh My Zsh) ---
export BAT_CONFIG_PATH="$HOME/.config/bat/config"
if (( $+commands[bat] )); then
  alias cat='bat'
fi

if (( $+commands[eza] )); then
  alias ls='eza --icons=auto --group-directories-first'
  alias ll='eza -l --icons=auto --group-directories-first --git --time-style=relative'
  alias la='eza -la --icons=auto --group-directories-first --git --time-style=relative'
  alias lt='eza --tree --level=2 --icons=auto --group-directories-first'
fi

# --- Zsh Tab Completion for `theme` ---
_kiseki_theme_complete() {
  compadd -- "${_KISEKI_THEME_IDS[@]}"
}
(( $+functions[compdef] )) && compdef _kiseki_theme_complete theme

# --- Apply Active Theme on Shell Startup ---
_kiseki_apply_shell_theme

# --- Auto-Greeting in Top-Level Interactive Terminal ---
if [[ -o interactive && -t 1 && -z "${NO_FETCH:-}" && -z "${_KISEKI_GREETED:-}" && "${SHLVL:-1}" -le 2 ]]; then
  export _KISEKI_GREETED=1
  fetch
fi
